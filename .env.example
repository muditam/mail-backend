NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
STALWART_URL=https://mail.60brands.com
STALWART_AUTH_URL=https://mail.60brands.com/api/auth
STALWART_TOKEN_URL=https://mail.60brands.com/auth/token
STALWART_JMAP_SESSION_URL=https://mail.60brands.com/.well-known/jmap
OAUTH_CLIENT_ID=60brands-webmail
OAUTH_REDIRECT_URI=https://webmail.60brands.com/auth/callback
# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
# Use a dedicated database/user on your existing MongoDB cluster.
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/
MONGODB_DB_NAME=webmail
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Exact domains only; subdomains must be listed explicitly.
INTERNAL_EMAIL_DOMAINS=muditam.com
# Optional: reports fail with REPORT_UNAVAILABLE until configured.
# IT_REPORT_EMAIL=it@muditam.com
# Set only after ingress strips forged Authentication-Results for this authserv-id.
# STALWART_AUTHSERV_ID=mail.60brands.com
